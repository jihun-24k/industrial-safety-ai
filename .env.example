# Copy to .env. Do not commit real values.
DB_PASSWORD=
# Optional: a separate MariaDB root password. Defaults to DB_PASSWORD.
DB_ROOT_PASSWORD=
# Generate with: openssl rand -hex 32
JWT_SECRET=
OPENAI_API_KEY=

# Optional input/answer translation and speech settings (defaults shown).
TRANSLATION_MODEL=gpt-4o-mini
TTS_MODEL=tts-1
TTS_VOICE=nova

# Optional; not needed for document chat.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
WHISPER_MODEL=small
# Optional comma-separated browser origins for live STT (Compose defaults to the frontend host port).
# STT_ALLOWED_ORIGINS=https://your-app.example

# Change these if native services are already using the default host ports.
FRONTEND_PORT=5173
AUTH_PORT=8080
RAG_PORT=8001
VOICE_PORT=8008
DB_PORT=53301
