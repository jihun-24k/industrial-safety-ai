# Copy to .env. Do not commit real values.
DB_PASSWORD=
# Optional: a separate MariaDB root password. Defaults to DB_PASSWORD.
DB_ROOT_PASSWORD=
# Generate with: openssl rand -hex 32
JWT_SECRET=
OPENAI_API_KEY=

# Optional; not needed for document chat.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
WHISPER_MODEL=small

# Change these if native services are already using the default host ports.
FRONTEND_PORT=5173
AUTH_PORT=8080
RAG_PORT=8001
VOICE_PORT=8008
DB_PORT=53301
